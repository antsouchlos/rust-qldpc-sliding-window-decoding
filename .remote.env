REMOTE_HOST=tsouchlos@insrk2.cel.kit.edu
REMOTE_DIR='~/.remote/$PROJECT'
ACTIVATE='eval "$(/usr/stud/tsouchlos/miniconda3/bin/conda shell.bash hook)" && conda activate rust-qldpc'
SETUP_CMD='conda env create -f environment.yml || conda env update -f environment.yml --prune'
BUILD_CMD='maturin develop --release'
BUILD_DEPS='src Cargo.toml Cargo.lock pyproject.toml'
FETCH_PATHS='results/ figures/'
EXCLUDES='data/raw/'
ENV_VARS='PYTHONUNBUFFERED=1 RUST_BACKTRACE=1'
RUNNER_py='python'
